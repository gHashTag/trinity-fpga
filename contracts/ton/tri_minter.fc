;; tri_minter.fc -- the TRI jetton master, whose ONLY mint path is an attestor
;; quorum (mint-on-acceptance).
;;
;; UNAUDITED. Built and executed in a TON VM sandbox (contracts/ton/tests), not
;; deployed anywhere. Mirrors the golden oracle src/trinet/mint_authority.zig:
;; every rule here must reproduce that oracle, and the sandbox tests replay its
;; vectors (same seeds, same digest, same signatures). Protocol of record:
;; specs/trinet/mint_on_acceptance.t27.
;;
;; THE MINTER IS THE JETTON MASTER, AND IT HAS NO ADMIN. A separate TEP-74
;; master with an admin key would give that key an unbounded mint, which is a
;; pre-mine with extra steps. Here `get_jetton_data` reports admin = addr_none,
;; and the only code that raises the supply is `op::mint_on_att` with a valid
;; M-of-N quorum. Genesis supply is zero. There is no founder, treasury or
;; liquidity mint, and no op that changes the code.
;;
;; THE WALLET is the TON Foundation reference jetton wallet, vendored unchanged
;; at a pinned commit (vendor/token-contract, UPSTREAM_COMMIT).
;;
;; THE RECIPIENT. The oracle's `worker` is a 32-byte chain-agnostic id. On TON
;; it is the account id of a workchain-0 address, and the mint goes to the
;; jetton wallet of `0:worker`. The app binds only workchain-0 wallets
;; (999-multibots render src/tri-wallet.ts), so the bound address IS the worker.
;;
;; Storage (4 refs, the cell maximum):
;;   total_supply : Coins       circulating mTRI; burns lower it
;;   minted_total : uint64      mTRI ever minted; the cap counter, never lowered
;;   epoch        : uint32      attestor-set generation, signed into every digest
;;   threshold    : uint8       M
;;   n_attestors  : uint8       N; attestors are keyed 0..N-1
;;   attestors    : ^Cell       dict uint8 -> uint256 ed25519 public key
;;   spent        : Maybe ^Cell dict uint128 global_nonce -> (), every nonce ever minted
;;   content      : ^Cell       TEP-64 metadata
;;   wallet_code  : ^Cell
;;
;; Units: every amount is mTRI, the jetton's base unit (decimals = 3). The cap is
;; 3^21 WHOLE TRI = 3^21 * 1000 mTRI.
;;
;; ONE MINTER: `minted_total` and `spent` are this contract's own. The supply
;; rule is "sum across all chains <= cap" and the oracle enforces it with one
;; shared ledger; on-chain nothing shares state without a bridge. So this
;; contract may be deployed only while it is the only minter (contracts/README.md).

#include "vendor/token-contract/stdlib.fc";
#include "vendor/token-contract/params.fc";
#include "vendor/token-contract/op-codes.fc";
#include "vendor/token-contract/jetton-utils.fc";

const int CAP_MTRI  = 10460353203000; ;; 3^21 TRI * 1000 (mTRI)
const int CHAIN_TON = 1;              ;; Chain.ton in the oracle

const int op::mint_on_att = 0x54524931; ;; "TRI1"
const int op::rotate      = 0x54524952; ;; "TRIR"

;; The least a mint message must carry: it deploys the worker's jetton wallet
;; and pays both computations; what is left returns to the sender as excesses.
const int MIN_MINT_VALUE = 50000000; ;; 0.05 TON

;; error codes (oracle order: zero, chain, epoch, replay, quorum, cap)
const int err::zero_amount   = 101;
const int err::wrong_chain   = 102;
const int err::wrong_epoch   = 103;
const int err::replayed      = 104;
const int err::sub_quorum    = 105;
const int err::over_cap      = 106;
const int err::low_value     = 107;
const int err::bad_attestors = 108;
const int err::not_wallet    = 109;
const int err::unknown_op    = 0xffff;

;; --- storage ---------------------------------------------------------------

(int, int, int, int, int, cell, cell, cell, cell) load_data() inline {
    slice ds = get_data().begin_parse();
    return (
        ds~load_coins(),      ;; total_supply
        ds~load_uint(64),     ;; minted_total
        ds~load_uint(32),     ;; epoch
        ds~load_uint(8),      ;; threshold
        ds~load_uint(8),      ;; n_attestors
        ds~load_ref(),        ;; attestors
        ds~load_dict(),       ;; spent
        ds~load_ref(),        ;; content
        ds~load_ref()         ;; wallet_code
    );
}

() save_data(int total_supply, int minted_total, int epoch, int threshold, int n,
             cell attestors, cell spent, cell content, cell wallet_code) impure inline {
    set_data(begin_cell()
        .store_coins(total_supply)
        .store_uint(minted_total, 64)
        .store_uint(epoch, 32)
        .store_uint(threshold, 8)
        .store_uint(n, 8)
        .store_ref(attestors)
        .store_dict(spent)
        .store_ref(content)
        .store_ref(wallet_code)
        .end_cell());
}

;; --- the oracle's rule -----------------------------------------------------

;; SHA-256 over the same big-endian layout as mint_authority.zig::digest:
;; worker(32) work_id(32) chain(1) amount(8) global_nonce(16) epoch(4) = 93 bytes.
int attestation_digest(int worker, int work_id, int chain, int amount, int nonce, int epoch) inline {
    return string_hash(begin_cell()
        .store_uint(worker, 256)
        .store_uint(work_id, 256)
        .store_uint(chain, 8)
        .store_uint(amount, 64)
        .store_uint(nonce, 128)
        .store_uint(epoch, 32)
        .end_cell().begin_parse());
}

;; Count DISTINCT attestors whose signature verifies over `digest`. Signatures
;; are keyed by attestor index, so one attestor cannot be counted twice, and a
;; key outside 0..N-1 is never consulted -- the oracle's quorumReached.
int count_quorum(int digest, cell attestors, cell sigs, int n) inline {
    int distinct = 0;
    int i = 0;
    while (i < n) {
        (slice pk, int has_pk) = attestors.udict_get?(8, i);
        (slice sg, int has_sig) = sigs.udict_get?(8, i);
        if (has_pk & has_sig) {
            if ((slice_bits(sg) == 512) & check_signature(digest, sg, pk.preload_uint(256))) {
                distinct += 1;
            }
        }
        i += 1;
    }
    return distinct;
}

;; The digest a quorum signs to hand the mint over to a new attestor set.
;; mint_authority.zig::rotationDigest:
;;   sha256("TRIR" ++ minter account id(32) ++ new_epoch(4) ++ M(1) ++ N(1) ++ keys_hash(32))
;;   keys_hash = fold over i in 0..N-1 of sha256(h ++ pubkey_i), from 32 zero bytes.
;; The minter's own address is inside, so a rotation signed for one deployment
;; (say testnet) cannot be replayed on another.
int keys_hash(cell attestors, int n) inline {
    int h = 0;
    int i = 0;
    while (i < n) {
        (slice pk, int found) = attestors.udict_get?(8, i);
        throw_unless(err::bad_attestors, found & (slice_bits(pk) == 256));
        h = string_hash(begin_cell().store_uint(h, 256).store_uint(pk.preload_uint(256), 256).end_cell().begin_parse());
        i += 1;
    }
    return h;
}

int rotation_digest(int minter, int new_epoch, int threshold, int n, int kh) inline {
    return string_hash(begin_cell()
        .store_uint(op::rotate, 32)
        .store_uint(minter, 256)
        .store_uint(new_epoch, 32)
        .store_uint(threshold, 8)
        .store_uint(n, 8)
        .store_uint(kh, 256)
        .end_cell().begin_parse());
}

;; --- messages --------------------------------------------------------------

() send_mint(slice to_owner, int amount, slice response, cell wallet_code, int query_id) impure inline {
    cell state_init = calculate_jetton_wallet_state_init(to_owner, my_address(), wallet_code);
    slice to_wallet = calculate_jetton_wallet_address(state_init);
    cell body = begin_cell()
        .store_uint(op::internal_transfer(), 32)
        .store_uint(query_id, 64)
        .store_coins(amount)
        .store_slice(my_address())  ;; from
        .store_slice(response)      ;; excesses go back to whoever paid the gas
        .store_coins(0)             ;; forward_ton_amount
        .store_uint(0, 1)           ;; forward_payload: empty, inline
        .end_cell();
    send_raw_message(begin_cell()
        .store_uint(0x18, 6)
        .store_slice(to_wallet)
        .store_coins(0)
        .store_uint(4 + 2 + 1, 1 + 4 + 4 + 64 + 32 + 1 + 1 + 1)
        .store_ref(state_init)
        .store_ref(body)
        .end_cell(), 64); ;; carry what is left of the incoming value
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    if (in_msg_body.slice_empty?()) { return (); } ;; plain top-up for storage

    slice cs = in_msg_full.begin_parse();
    int flags = cs~load_uint(4);
    slice sender = cs~load_msg_addr();

    (int total_supply, int minted_total, int epoch, int threshold, int n,
     cell attestors, cell spent, cell content, cell wallet_code) = load_data();

    if (flags & 1) {
        ;; A mint the worker's wallet refused. The nonce stays spent and the
        ;; cap counter is not lowered (both stay conservative); only the
        ;; circulating supply drops, because those tokens were never delivered.
        in_msg_body~skip_bits(32);
        if (in_msg_body~load_uint(32) == op::internal_transfer()) {
            in_msg_body~skip_bits(64);
            total_supply -= in_msg_body~load_coins();
            save_data(total_supply, minted_total, epoch, threshold, n, attestors, spent, content, wallet_code);
        }
        return ();
    }

    int op = in_msg_body~load_uint(32);
    int query_id = in_msg_body~load_uint(64);

    if (op == op::mint_on_att) {
        int worker    = in_msg_body~load_uint(256);
        int work_id   = in_msg_body~load_uint(256);
        int chain     = in_msg_body~load_uint(8);
        int amount    = in_msg_body~load_uint(64);
        int nonce     = in_msg_body~load_uint(128);
        int att_epoch = in_msg_body~load_uint(32);
        cell sigs     = in_msg_body~load_dict();

        ;; the oracle's checks, in the oracle's order
        throw_if(err::zero_amount, amount == 0);
        throw_unless(err::wrong_chain, chain == CHAIN_TON);
        throw_unless(err::wrong_epoch, att_epoch == epoch);
        (_, int seen) = spent.udict_get?(128, nonce);
        throw_if(err::replayed, seen);
        int digest = attestation_digest(worker, work_id, chain, amount, nonce, att_epoch);
        throw_unless(err::sub_quorum, count_quorum(digest, attestors, sigs, n) >= threshold);
        ;; cap last, so an over-cap attempt consumes no nonce
        int next = minted_total + amount;
        throw_if(err::over_cap, next > CAP_MTRI);
        ;; not an oracle rule: a mint must pay for the worker's wallet
        throw_unless(err::low_value, msg_value >= MIN_MINT_VALUE);

        spent~udict_set_builder(128, nonce, begin_cell());
        save_data(total_supply + amount, next, epoch, threshold, n, attestors, spent, content, wallet_code);

        slice to_owner = begin_cell().store_uint(4, 3).store_int(workchain(), 8).store_uint(worker, 256).end_cell().begin_parse();
        send_mint(to_owner, amount, sender, wallet_code, query_id);
        return ();
    }

    if (op == op::burn_notification()) {
        int amount = in_msg_body~load_coins();
        slice from_owner = in_msg_body~load_msg_addr();
        throw_unless(err::not_wallet,
            equal_slices(calculate_user_jetton_wallet_address(from_owner, my_address(), wallet_code), sender));
        ;; burned mTRI leaves circulation; the cap counter does not reopen
        save_data(total_supply - amount, minted_total, epoch, threshold, n, attestors, spent, content, wallet_code);
        slice response = in_msg_body~load_msg_addr();
        if (response.preload_uint(2) != 0) {
            send_raw_message(begin_cell()
                .store_uint(0x10, 6)
                .store_slice(response)
                .store_coins(0)
                .store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1)
                .store_uint(op::excesses(), 32)
                .store_uint(query_id, 64)
                .end_cell(), 2 + 64);
        }
        return ();
    }

    if (op == op::rotate) {
        ;; THE ONLY GOVERNANCE OP: the current quorum hands the mint to a new
        ;; attestor set, one epoch forward. Nobody else can change who mints.
        int new_epoch     = in_msg_body~load_uint(32);
        int new_threshold = in_msg_body~load_uint(8);
        int new_n         = in_msg_body~load_uint(8);
        cell new_attestors = in_msg_body~load_ref();
        cell sigs          = in_msg_body~load_dict();

        throw_unless(err::wrong_epoch, new_epoch == epoch + 1);
        throw_unless(err::bad_attestors, (new_threshold >= 1) & (new_threshold <= new_n));
        (_, int me) = parse_std_addr(my_address());
        int digest = rotation_digest(me, new_epoch, new_threshold, new_n, keys_hash(new_attestors, new_n));
        throw_unless(err::sub_quorum, count_quorum(digest, attestors, sigs, n) >= threshold);

        save_data(total_supply, minted_total, new_epoch, new_threshold, new_n, new_attestors, spent, content, wallet_code);
        return ();
    }

    throw(err::unknown_op);
}

;; --- get-methods -----------------------------------------------------------

;; TEP-74. admin_address is addr_none: there is no admin.
(int, int, slice, cell, cell) get_jetton_data() method_id {
    (int total_supply, _, _, _, _, _, _, cell content, cell wallet_code) = load_data();
    return (total_supply, -1, begin_cell().store_uint(0, 2).end_cell().begin_parse(), content, wallet_code);
}

slice get_wallet_address(slice owner) method_id {
    (_, _, _, _, _, _, _, _, cell wallet_code) = load_data();
    return calculate_user_jetton_wallet_address(owner, my_address(), wallet_code);
}

;; (minted_total, cap, epoch, threshold, n_attestors)
(int, int, int, int, int) get_tri_state() method_id {
    (_, int minted_total, int epoch, int threshold, int n, _, _, _, _) = load_data();
    return (minted_total, CAP_MTRI, epoch, threshold, n);
}

int is_spent(int nonce) method_id {
    (_, _, _, _, _, _, cell spent, _, _) = load_data();
    (_, int seen) = spent.udict_get?(128, nonce);
    return seen;
}

int attestor_key(int index) method_id {
    (_, _, _, _, _, cell attestors, _, _, _) = load_data();
    (slice pk, int found) = attestors.udict_get?(8, index);
    return found ? pk.preload_uint(256) : 0;
}
