// SPDX-License-Identifier: Apache-2.0
; specs/trinet/tern_tc_generate_t27_ax7203.t27 -- pre-registration: the same chain generates tokens
; with its ternary dot products computed on the AX7203 node, but under the weights fine-tuned on
; the t27 corpus; the model ends the run itself with EOT after 7 tokens
; The one source for this run. conformance/tern_tc_generate_t27_from_spec.mjs compiles this file
; with the t27 compiler (wasm), evaluates every test block below, checks the pinned files and the
; model header, and writes conformance/tern_tc_generate_t27_params.py. The runner is the 8-token
; arm's conformance/tern_tc_generate_ax7203.py, imported unchanged and pinned by sha256 below: the
; wrapper conformance/tern_tc_generate_t27_ax7203.py only installs these parameters under the
; module name the runner reads, so every --self-test, --cpu and preflight runs the pinned code. No
; number below is typed a second time; `--check` fails on drift. Written 2026-09-28 before any run
; of it. ASCII, English.

; WHY. The 8-token run (conformance/TERN_TC_GENERATE.md, FAIL: 56 answer bytes lost behind the
; Genesys hub), its reopen variant (conformance/TERN_TC_REOPEN.md, PASS 7682304/7682304, 0 lost)
; and the 32-token long arm (conformance/TERN_TC_GENERATE_LONG.md) proved the chain under the base
; tern_tc weights. T35 changes the weights, not the chain: the same 9076800-parameter model after
; 337 steps of fine-tuning on 8K-tokenized t27 fill-in-the-middle data (val bpb 0.756 -> 0.611),
; sha256 below. The base model from token 0 walks into a period-8 repeat loop within 16 tokens;
; the tuned model from the same start emits one complete statement and ends the run itself with
; EOT. So this is the first arm whose length the model, not the host, chooses: 7 tokens, and the
; 7th is <|endoftext|>. New claim, own record: conformance/TERN_TC_GENERATE_T27.md.

; WHAT RUNS WHERE. Unchanged from the 8-token run: per token the board computes every row of wq wk
; wv wo gate up down in all 6 layers times the int8 activation that feeds it, in 32-trit chunks,
; one signed receipt per chunk; the host does embedding, RMSNorm, the 8-bit absmax quantiser, RoPE,
; attention, SiLU, the fp32 tied head and the greedy argmax. Only the weights and the length
; change. The board arm runs through the reopen harness (specs/trinet/tern_tc_reopen_t27_ax7203.t27)
; for the same reason as the 32-token arm: behind adapters bytes get lost, and the reopen link is
; the only harness that survived one. One scheduled rx hole of that arm lies past this run's
; 127545024 answer bytes and never fires; that arm's spec says so.

; WHAT IS FIXED BEFORE THE RUN.
;   C_GREEDY_IDS: the runner's own float mode (--mode c, tc_infer.c's order), 7 tokens from
;     token 0. The ids differ from every earlier arm's: that is the fine-tune, recorded here.
;   CPU_INT_IDS: the runner's integer path (--cpu), 7 tokens. Equals C_GREEDY_IDS id for id.
;     Decoded with the pinned 8K tokenizer they read '\n    return 0;\n<|endoftext|>'.
;   JOBS_EXPECTED, SKIPPED_EXPECTED: counted on that CPU path. Jobs per token are not constant
;     (6712896 is not 7 x 960288): which digit planes are all zero depends on the activations,
;     so the counts are counted, not extrapolated.
;   MIN_MARGIN_MILLI: the smallest top-1 minus top-2 logit gap over the 7 tokens, times 1000:
;     210 (token 2, the integer path; the c path's is 190). It says how close the nearest tie is;
;     it is not a tolerance.
;   THE 128-TOKEN CONTINUATION, CPU only: it does not exist. Asked for 128 tokens the greedy path
;     stops at token 7 all the same (ids identical, jobs 6712896, skipped 1754304, rows 118272,
;     calls 168, margin 210 milli on both CPU orders): the model emits EOT and the host stops
;     asking. The base model needed 16 tokens to fall into its repeat loop; the tuned model never
;     gets the chance.

; PREDICTION. Board token ids == CPU_INT_IDS, every receipt verified under the node key, every row
; bit-exact, jobs == JOBS_EXPECTED, elapsed <= LIMIT_S. The board sum replaces the host sum in the
; forward pass, so one wrong accepted sum could change a token after the first; no CPU reference
; existed until this spec fixed one. The run aborts at the first rejected receipt or inexact row
; instead, and then no token from it is cited.
; WHAT IT DOES NOT SAY. It is not text quality: '\n    return 0;\n' is one syntactically clean
; line, but one line is not a program, and the 8K tokenizer pinned in artifacts/tokenizers/ is for
; reading the ids, not a claim about what they spell. It is not speed: about 4.7 k answers per
; second over UART puts the run near 24 minutes. It is one run of 7 tokens from one start token,
; greedy, one model checkpoint.

module trinet_tern_tc_generate_t27_ax7203;

pub const KIND : str = "board-run-preregistration";
pub const ID : str = "trinet/tern_tc_generate_t27_ax7203";
pub const GENERATED : [1]str = ["conformance/tern_tc_generate_t27_params.py"];
pub const RUNNER : str = "conformance/tern_tc_generate_t27_ax7203.py";
pub const RECORD_DOC : str = "conformance/TERN_TC_GENERATE_T27.md";
pub const LOG_NAME : str = "gen_tokens_7_t27";

; --- Code and data of record: imported or read, never edited --------------------------------
pub const HARNESS_FILE : str = "conformance/tern_tc_layer_ax7203.py";
pub const HARNESS_SHA256 : str = "37f2dbc313b348a35b927f07f9532a4faed08d6b0b7f2889d5c34b09bd70e8d8";
pub const MAC32_FILE : str = "conformance/trinet_mac32_conformance_ax7203.py";
pub const MAC32_SHA256 : str = "11fa651938a0e360a311f63ec4c04de15241ad9a7c6e26175ead084e07ababa2";
pub const MODEL : str = "~/igla-coder-gpu/c_infer/t27_tuned/model.bin";
pub const MODEL_SHA256 : str = "3d8397ef4e388d0cadd1725f64d45ddd4ca0811cf8fbedc4a6a3b2fe92cd45cc";
; the 8- and 32-token arms pinned this file before it gained two portability header lines
; (igla-coder-gpu 52be443, 2026-09-28 22:35 +07: _POSIX_C_SOURCE + stdint.h; no arithmetic line
; changed, and their pinned bytes stay reachable at ceba14a). This arm pins the current file.
pub const C_REF_FILE : str = "~/igla-coder-gpu/c_infer/tc_infer.c";
pub const C_REF_SHA256 : str = "cfd640a6f1baa441faca3093671be51730835e4f4042cb6f3659b0ccdc688c07";

; --- Model shape (read back from the model header by the generator) -------------------------
pub const N_LAYER : u8 = 6;
pub const N_HEAD : u8 = 5;
pub const N_KV : u8 = 1;
pub const D_MODEL : u16 = 320;
pub const D_FF : u16 = 864;
pub const HEAD_DIM : u8 = 64;
pub const VOCAB : u16 = 8192;

; --- Encoding (the harness's) ---------------------------------------------------------------
pub const N_TRITS : u8 = 32;
pub const INT8_DIGITS : u8 = 6;
pub const ROWS_PER_LAYER : u16 = 2816;
pub const ROWS_PER_TOKEN : u16 = 16896;
pub const JOBS_PER_TOKEN_FULL : u32 = 1209600;
; four harness calls per layer: q/k/v share one activation, then wo, gate/up, down
pub const CALLS_PER_LAYER : u8 = 4;

; --- The run --------------------------------------------------------------------------------
pub const START_TOKEN : u16 = 0;
pub const STOP_TOKEN : u16 = 0;
pub const N_TOKENS : u8 = 7;
pub const SKIP_ZERO_X_CHUNKS : u8 = 1;
pub const WINDOW : u8 = 24;
pub const BAUD : u32 = 1144744;
pub const NODE_ID : u32 = 1414678862;
pub const RESP_LEN : u8 = 19;
pub const MAGIC_RESP : u8 = 165;
pub const CP2102N_RX_BYTES : u16 = 512;
pub const FIRST_JOB_NONCE : u32 = 65536;
pub const SETKEY_NONCE : u32 = 2122186753;
; the 8-token arm's ceiling again: this run sends fewer jobs than that arm did (6712896 vs
; 7682304), so 3600 s holds at the same 2500/s floor with room for every reopen ceiling
pub const LIMIT_S : u16 = 3600;
; throughput floor the limit assumes; the W24 reload after E2 measured 403200 answers in 85.81 s
pub const MIN_ANSWERS_PER_S : u16 = 2500;

; --- Fixed before the run (see above) -------------------------------------------------------
pub const C_GREEDY_IDS : [7]u16 = [204, 264, 397, 226, 21, 277, 0];
pub const CPU_INT_IDS : [7]u16 = [204, 264, 397, 226, 21, 277, 0];
pub const JOBS_EXPECTED : u32 = 6712896;
pub const SKIPPED_EXPECTED : u32 = 1754304;
pub const ROWS_EXPECTED : u32 = 118272;
pub const CALLS_EXPECTED : u16 = 168;
pub const MIN_MARGIN_MILLI : u16 = 210;

test node_id_is_trin {
    assert NODE_ID == 84 * 16777216 + 82 * 65536 + 73 * 256 + 78;
    assert MAGIC_RESP == 10 * 16 + 5;
}

test model_shape {
    assert N_HEAD * HEAD_DIM == D_MODEL;
    assert D_MODEL == 10 * N_TRITS;
    assert D_FF == 27 * N_TRITS;
    assert ROWS_PER_LAYER == N_HEAD * HEAD_DIM + 2 * N_KV * HEAD_DIM + D_MODEL + 2 * D_FF + D_MODEL;
    assert ROWS_PER_TOKEN == ROWS_PER_LAYER * N_LAYER;
}

test six_digits_cover_int8_and_five_do_not {
    assert 3 * 3 * 3 * 3 * 3 * 3 - 1 >= 2 * 128;
    assert 3 * 3 * 3 * 3 * 3 - 1 < 2 * 128;
    assert INT8_DIGITS == 6;
}

test jobs_per_token {
    assert JOBS_PER_TOKEN_FULL == INT8_DIGITS * N_LAYER * ((N_HEAD * HEAD_DIM + 2 * N_KV * HEAD_DIM + D_MODEL + 2 * D_FF) * 10 + D_MODEL * 27);
    assert JOBS_PER_TOKEN_FULL == 1209600;
}

test run_totals {
    assert JOBS_EXPECTED + SKIPPED_EXPECTED == JOBS_PER_TOKEN_FULL * N_TOKENS;
    assert ROWS_EXPECTED == ROWS_PER_TOKEN * N_TOKENS;
    assert CALLS_EXPECTED == CALLS_PER_LAYER * N_LAYER * N_TOKENS;
}

test jobs_per_token_are_not_constant {
    assert JOBS_EXPECTED != 960288 * N_TOKENS;
    assert JOBS_EXPECTED < 960288 * N_TOKENS;
}

test nonces_stay_clear_of_setkey {
    assert FIRST_JOB_NONCE + JOBS_PER_TOKEN_FULL * N_TOKENS < SETKEY_NONCE;
    assert SETKEY_NONCE == 126 * 16777216 + 126 * 65536 + 1;
}

test window_under_the_uart_buffer {
    assert RESP_LEN * WINDOW < CP2102N_RX_BYTES;
    assert WINDOW == 24;
}

test run_fits_its_limit {
    assert LIMIT_S * MIN_ANSWERS_PER_S >= JOBS_EXPECTED;
    assert LIMIT_S == 3600;
}

test the_model_ends_its_own_generation {
    assert N_TOKENS == 7;
    assert STOP_TOKEN == 0;
    assert CPU_INT_IDS[6] == STOP_TOKEN;
    assert CPU_INT_IDS[5] != STOP_TOKEN;
}

test ids_are_in_the_vocabulary_and_agree {
    assert C_GREEDY_IDS[0] == CPU_INT_IDS[0];
    assert C_GREEDY_IDS[1] == CPU_INT_IDS[1];
    assert C_GREEDY_IDS[2] == CPU_INT_IDS[2];
    assert C_GREEDY_IDS[3] == CPU_INT_IDS[3];
    assert C_GREEDY_IDS[4] == CPU_INT_IDS[4];
    assert C_GREEDY_IDS[5] == CPU_INT_IDS[5];
    assert C_GREEDY_IDS[6] == CPU_INT_IDS[6];
    assert CPU_INT_IDS[6] < VOCAB;
    assert CPU_INT_IDS[2] < VOCAB;
    assert CPU_INT_IDS[0] != STOP_TOKEN;
}
