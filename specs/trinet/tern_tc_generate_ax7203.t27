// SPDX-License-Identifier: Apache-2.0
; specs/trinet/tern_tc_generate_ax7203.t27 -- pre-registration: igla-coder generates tokens with its
; ternary dot products computed on the AX7203 node
; The one source for this run. conformance/tern_tc_generate_from_spec.mjs compiles this file with the
; t27 compiler (wasm), evaluates every test block below, checks the pinned files and the model header,
; and writes conformance/tern_tc_generate_params.py, which the runner
; conformance/tern_tc_generate_ax7203.py reads. No number below is typed a second time; `--check`
; fails on drift. Written 2026-09-27 before the board run. ASCII, English.

; WHY. The owner, 2026-09-27: "vse tri i nado chtoby ona mogla kodit'! eto byla zadacha iz nachala!"
; The board has computed all 42 ternary matrices of igla-coder bit-exactly (403200 of 403200 receipts,
; W24), but on synthetic activations, and no token came out of it. This run closes that gap: the
; activations are the model's own, token by token, and the token ids are the output.

; WHAT RUNS WHERE, per token. Board: every row of wq wk wv wo gate up down in all 6 layers times the
; int8 activation that feeds it, in 32-trit chunks, one chunk per balanced-ternary digit plane of the
; activation, one signed receipt per chunk. Host: embedding, RMSNorm, the 8-bit absmax quantiser,
; RoPE, attention, SiLU, the fp32 tied head and the greedy argmax, in float32 in tc_infer.c's order.
; A chunk whose activation digit plane is all zero is not sent (its dot is 0 whatever the weights
; are); the runner counts those and prints the count.

; WHAT IS FIXED BEFORE THE RUN.
;   C_GREEDY_IDS: tc_infer.c (sha below) compiled on this Mac, greedy, from token 0; first 8 ids.
;   CPU_INT_IDS: the runner's own forward pass with the integer dots done on the host (--cpu).
;     It also reproduces all 24 ids tc_infer.c printed, and so does its float mode (--mode c).
;   JOBS_EXPECTED, SKIPPED_EXPECTED: counted on that CPU path. If every board sum equals the CPU
;     sum the activations are identical, so these counts are exact predictions, not estimates.
;   MIN_MARGIN_MILLI: the smallest top-1 minus top-2 logit gap over the 8 tokens on the CPU path,
;     times 1000 (token 3). It says how close the nearest tie is; it is not a tolerance.

; PREDICTION. Board token ids == CPU_INT_IDS, every receipt verified under the node key, every row
; bit-exact, jobs == JOBS_EXPECTED. The board sum replaces the host sum in the forward pass, so one
; wrong accepted sum could change a token; the run aborts at the first rejected receipt or inexact
; row instead, and then no token from it is cited.
; WHAT IT DOES NOT SAY. It is not text: the 8K tokenizer that turns ids into characters is on the
; RunPod volume only and is not on this Mac. It is not speed: about 4.7 k dots per second over UART
; is minutes per token. It is one run of 8 tokens from one start token, greedy.

module trinet_tern_tc_generate_ax7203;

pub const KIND : str = "board-run-preregistration";
pub const ID : str = "trinet/tern_tc_generate_ax7203";
pub const GENERATED : [1]str = ["conformance/tern_tc_generate_params.py"];
pub const RUNNER : str = "conformance/tern_tc_generate_ax7203.py";
pub const RECORD_DOC : str = "conformance/TERN_TC_GENERATE.md";
pub const LOG_NAME : str = "gen_tokens_8";

; --- Code and data of record: imported or read, never edited --------------------------------
pub const HARNESS_FILE : str = "conformance/tern_tc_layer_ax7203.py";
pub const HARNESS_SHA256 : str = "8a9a5f6ef57fdad6e1f6afddb3cbdb1b8f806fbf3e3cb5c11b2c060e1b3729aa";
pub const MAC32_FILE : str = "conformance/trinet_mac32_conformance_ax7203.py";
pub const MAC32_SHA256 : str = "11fa651938a0e360a311f63ec4c04de15241ad9a7c6e26175ead084e07ababa2";
pub const MODEL : str = "~/igla-coder-gpu/c_infer/model.bin";
pub const MODEL_SHA256 : str = "3102abdf35057924e077a86db4fdac726e4fe1f6574df47f39a638ba99a3ce9c";
pub const C_REF_FILE : str = "~/igla-coder-gpu/c_infer/tc_infer.c";
pub const C_REF_SHA256 : str = "33a7f98d8a1df5a6f634a96154b3d005425daa1f82952739105d0cabb24be963";

; --- Model shape (read back from the model header by the generator) -------------------------
pub const N_LAYER : u8 = 6;
pub const N_HEAD : u8 = 5;
pub const N_KV : u8 = 1;
pub const D_MODEL : u16 = 320;
pub const D_FF : u16 = 864;
pub const HEAD_DIM : u8 = 64;
pub const VOCAB : u16 = 8192;

; --- Encoding (the harness's) ---------------------------------------------------------------
pub const N_TRITS : u8 = 32;
pub const INT8_DIGITS : u8 = 6;
pub const ROWS_PER_LAYER : u16 = 2816;
pub const ROWS_PER_TOKEN : u16 = 16896;
pub const JOBS_PER_TOKEN_FULL : u32 = 1209600;
; four harness calls per layer: q/k/v share one activation, then wo, gate/up, down
pub const CALLS_PER_LAYER : u8 = 4;

; --- The run --------------------------------------------------------------------------------
pub const START_TOKEN : u16 = 0;
pub const STOP_TOKEN : u16 = 0;
pub const N_TOKENS : u8 = 8;
pub const SKIP_ZERO_X_CHUNKS : u8 = 1;
pub const WINDOW : u8 = 24;
pub const BAUD : u32 = 1144744;
pub const NODE_ID : u32 = 1414678862;
pub const RESP_LEN : u8 = 19;
pub const MAGIC_RESP : u8 = 165;
pub const CP2102N_RX_BYTES : u16 = 512;
pub const FIRST_JOB_NONCE : u32 = 65536;
pub const SETKEY_NONCE : u32 = 2122186753;
pub const LIMIT_S : u16 = 3600;
; throughput floor the limit assumes; the W24 reload after E2 measured 403200 answers in 85.81 s
pub const MIN_ANSWERS_PER_S : u16 = 2500;

; --- Fixed before the run (see above) -------------------------------------------------------
pub const C_GREEDY_IDS : [8]u16 = [1, 3, 204, 276, 405, 659, 85, 1516];
pub const CPU_INT_IDS : [8]u16 = [1, 3, 204, 276, 405, 659, 85, 1516];
pub const JOBS_EXPECTED : u32 = 7682304;
pub const SKIPPED_EXPECTED : u32 = 1994496;
pub const ROWS_EXPECTED : u32 = 135168;
pub const CALLS_EXPECTED : u16 = 192;
pub const MIN_MARGIN_MILLI : u16 = 35;

test node_id_is_trin {
    assert NODE_ID == 84 * 16777216 + 82 * 65536 + 73 * 256 + 78;
    assert MAGIC_RESP == 10 * 16 + 5;
}

test model_shape {
    assert N_HEAD * HEAD_DIM == D_MODEL;
    assert D_MODEL == 10 * N_TRITS;
    assert D_FF == 27 * N_TRITS;
    assert ROWS_PER_LAYER == N_HEAD * HEAD_DIM + 2 * N_KV * HEAD_DIM + D_MODEL + 2 * D_FF + D_MODEL;
    assert ROWS_PER_TOKEN == ROWS_PER_LAYER * N_LAYER;
}

test six_digits_cover_int8_and_five_do_not {
    assert 3 * 3 * 3 * 3 * 3 * 3 - 1 >= 2 * 128;
    assert 3 * 3 * 3 * 3 * 3 - 1 < 2 * 128;
    assert INT8_DIGITS == 6;
}

test jobs_per_token {
    assert JOBS_PER_TOKEN_FULL == INT8_DIGITS * N_LAYER * ((N_HEAD * HEAD_DIM + 2 * N_KV * HEAD_DIM + D_MODEL + 2 * D_FF) * 10 + D_MODEL * 27);
    assert JOBS_PER_TOKEN_FULL == 1209600;
}

test run_totals {
    assert JOBS_EXPECTED + SKIPPED_EXPECTED == JOBS_PER_TOKEN_FULL * N_TOKENS;
    assert ROWS_EXPECTED == ROWS_PER_TOKEN * N_TOKENS;
    assert CALLS_EXPECTED == CALLS_PER_LAYER * N_LAYER * N_TOKENS;
}

test nonces_stay_clear_of_setkey {
    assert FIRST_JOB_NONCE + JOBS_PER_TOKEN_FULL * N_TOKENS < SETKEY_NONCE;
    assert SETKEY_NONCE == 126 * 16777216 + 126 * 65536 + 1;
}

test window_under_the_uart_buffer {
    assert RESP_LEN * WINDOW < CP2102N_RX_BYTES;
    assert WINDOW == 24;
}

test run_fits_its_limit {
    assert LIMIT_S * MIN_ANSWERS_PER_S >= JOBS_EXPECTED;
    assert LIMIT_S <= 3600;
}

test ids_are_in_the_vocabulary_and_agree {
    assert C_GREEDY_IDS[0] == CPU_INT_IDS[0];
    assert C_GREEDY_IDS[1] == CPU_INT_IDS[1];
    assert C_GREEDY_IDS[2] == CPU_INT_IDS[2];
    assert C_GREEDY_IDS[3] == CPU_INT_IDS[3];
    assert C_GREEDY_IDS[4] == CPU_INT_IDS[4];
    assert C_GREEDY_IDS[5] == CPU_INT_IDS[5];
    assert C_GREEDY_IDS[6] == CPU_INT_IDS[6];
    assert C_GREEDY_IDS[7] == CPU_INT_IDS[7];
    assert CPU_INT_IDS[7] < VOCAB;
    assert CPU_INT_IDS[0] != STOP_TOKEN;
}
