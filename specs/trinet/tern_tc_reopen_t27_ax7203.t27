// SPDX-License-Identifier: Apache-2.0
; specs/trinet/tern_tc_reopen_t27_ax7203.t27 -- pre-registration: the 7-token t27-tuned igla-coder
; generation on the AX7203 node, with retransmits and the serial port closed and opened again when
; a resync meets a silent line
; The one source for this run. conformance/tern_tc_reopen_t27_from_spec.mjs compiles this file with
; the t27 compiler (wasm), evaluates every test block below, checks the pinned files, reads back the
; constants it repeats from the t27 generation and retransmit specs' generated params, and writes
; conformance/tern_tc_reopen_t27_params.py, which the wrapper
; conformance/tern_tc_generate_reopen_t27_ax7203.py reads. The wrapper installs the t27 parameters
; under the module names the pinned runners read (tern_tc_generate_params, tern_tc_reopen_params)
; and then imports the unchanged runner conformance/tern_tc_generate_reopen_ax7203.py, so every
; --self-test, --refcell, preflight and board byte runs the pinned code. `--check` fails on drift.
; Written 2026-09-28 before any run of it. ASCII, English.

; WHY. The 8-token reopen run (conformance/TERN_TC_REOPEN.md, PASS 7682304/7682304, 0 bytes lost,
; 0 reopens needed) and the 32-token long reopen run proved the harness on the hub-free DIRECT UART.
; T35 runs the same chain under new weights: the model fine-tuned on the t27 corpus
; (specs/trinet/tern_tc_generate_t27_ax7203.t27 says what changed and fixes the ids). 7 tokens,
; 6712896 answers, 127545024 answer bytes -- shorter than the 8-token arm, but still far past the
; hub-free loss-free evidence itself (23385600 answers, conformance/UART_LOSS_HUBFREE.md), so a
; lost byte stays expected somewhere behind any adapter, and the reopen link is the only harness
; that has survived one. New claim, own record: conformance/TERN_TC_GENERATE_T27.md.

; WHAT CHANGES FROM THE 32-TOKEN REOPEN RUN. Only the weights and the length, through the t27
; generation spec's parameters: N_TOKENS 7, JOBS_EXPECTED 6712896, and LIMIT_S back to 3600 (this
; run sends fewer answers than the 8-token arm did, 6712896 vs 7682304; the long arm's 13500 does
; not apply -- the change is stated here, not hidden). Every link, protocol, ceiling, window and
; key-handling byte is the earlier reopen runs', imported unchanged and pinned below. The token ids
; and every count the run must equal are the t27 generation spec's, fixed on the CPU before this
; file was written.

; WHAT IS NEVER RETRIED (the run stops). Everything the 8-token reopen spec lists: MAX_ATTEMPTS
; nonces per job, a reopen past MAX_REOPENS, and every receipt lie.

; PREDICTION (board). Token ids == CPU_INT_IDS of the t27 generation spec; every one of
; JOBS_EXPECTED jobs credited by exactly one answer whose tag verifies under the node key; every
; row bit-exact; retransmits <= MAX_RETRANSMITS; resyncs <= MAX_RESYNCS; reopens <= MAX_REOPENS;
; one node id throughout; elapsed <= LIMIT_S. The runner prints `receipts verified (tag) : N/N`
; only then. The run ends because the model emits EOT at token 7, the first arm whose length the
; model, not the host, chooses; the termination is the CPU paths' own behavior, fixed in the t27
; generation spec, not a board property.
; PREDICTION (rehearsal, no board). The whole 7-token run through the reference cell behind the
; RTL's frame parser, with the retransmit spec's five scheduled losses -- of which four fall inside
; this run's streams and fire: the rx hole at byte 137468535 lies past the 127545024-byte answer
; stream and never fires, a fact fixed by the test block below -- and the two stalls, ends
; REHEARSAL OK with the same ids and counts, at least one retransmit per scheduled loss that
; fired, and exactly REHEARSAL_STALLS reopens: one per stall, none for the ordinary losses. The
; stalls keep the earlier rehearsals' offsets: the mechanism a reopen clears is
; position-independent byte counters, and both still fall inside this shorter run (answer 5754002
; of 6712896, request 2000000 of 6712896). After the reopen at answer 5754002 the run must
; continue to 6712896 and stay bit-exact.
; WHAT IT DOES NOT SAY. It does not find which side stalls or loses. It does not say the UART is
; lossless. It is not speed and not text quality (one clean line is not a program; the t27
; generation spec says why). One attempt; a second only if the first fails before its first job,
; and then both are recorded.

module trinet_tern_tc_reopen_t27_ax7203;

pub const KIND : str = "board-run-preregistration";
pub const ID : str = "trinet/tern_tc_reopen_t27_ax7203";
pub const GENERATED : [1]str = ["conformance/tern_tc_reopen_t27_params.py"];
pub const RUNNER : str = "conformance/tern_tc_generate_reopen_t27_ax7203.py";
pub const RECORD_DOC : str = "conformance/TERN_TC_GENERATE_T27.md";
pub const LOG_NAME : str = "gen_tokens_7_t27_reopen";

; --- Code and data of record: imported or read, never edited --------------------------------
pub const GENERATE_SPEC_FILE : str = "specs/trinet/tern_tc_generate_t27_ax7203.t27";
pub const GENERATE_SPEC_SHA256 : str = "cbb75b4a026a3c923a3694b83bf8aa5e388f67941f9871f88a17d17e00fb08ba";
pub const GENERATE_PARAMS_FILE : str = "conformance/tern_tc_generate_t27_params.py";
pub const GENERATE_PARAMS_SHA256 : str = "566379795426f09a86b6a22d81bfa6a68dca61a528819dcc427ee6e7b282e7b2";
pub const GENERATE_RUNNER_FILE : str = "conformance/tern_tc_generate_ax7203.py";
pub const GENERATE_RUNNER_SHA256 : str = "72136fe7c898fa53e0c2042b0203530bcb91ecda2d044f8958b28434420b37a5";
pub const HARNESS_FILE : str = "conformance/tern_tc_layer_ax7203.py";
pub const HARNESS_SHA256 : str = "37f2dbc313b348a35b927f07f9532a4faed08d6b0b7f2889d5c34b09bd70e8d8";
pub const NODE_RTL_FILE : str = "fpga/portable/trinet_node_core.v";
pub const NODE_RTL_SHA256 : str = "fc22d2c14b2acfd05a250385e96bbd88cc56bf41c6bb825a4f9a3916d7200f45";
pub const PROTOCOL_FILE : str = "conformance/tern_tc_retransmit.py";
pub const PROTOCOL_SHA256 : str = "eda9f8bced1a0f251324f35e1d5843e565dbb283c48a6590318f98eba912833b";
pub const RT_SPEC_FILE : str = "specs/trinet/tern_tc_retransmit_ax7203.t27";
pub const RT_SPEC_SHA256 : str = "e7078b22b10cb5449501a9b8038f84f36675d2dbaee671bb70e5245e3e3e5c10";
pub const RT_PARAMS_FILE : str = "conformance/tern_tc_retransmit_params.py";
pub const RT_PARAMS_SHA256 : str = "c7cc4d1b417e673813dfcd3fd198f47ca93cc10fc11bea79e0fd76be01dfb8b4";
pub const RT_RUNNER_FILE : str = "conformance/tern_tc_generate_rt_ax7203.py";
pub const RT_RUNNER_SHA256 : str = "b42ab095684d7019a51b4e5ef0fc92ee4d543a4c0a7f120d8be8736e6d833492";
pub const REOPEN_FILE : str = "conformance/tern_tc_reopen.py";
pub const REOPEN_SHA256 : str = "4bfd81b3ae1974a3d4b028bf26d4a30f8484f7087e5514f582002fa6c79cb14d";

; --- Repeated from the t27 generation spec; the generator reads each back from its params ----
pub const N_TOKENS : u8 = 7;
pub const JOBS_EXPECTED : u32 = 6712896;
pub const JOBS_PER_TOKEN_FULL : u32 = 1209600;
pub const FIRST_JOB_NONCE : u32 = 65536;
pub const SETKEY_NONCE : u32 = 2122186753;
pub const WINDOW : u8 = 24;
pub const RESP_LEN : u8 = 19;
pub const BAUD : u32 = 1144744;
pub const NODE_ID : u32 = 1414678862;

; --- Repeated from the retransmit spec; read back from its params ----------------------------
pub const REQ_LEN : u8 = 24;
pub const REQ_BODY : u8 = 22;
pub const RETRY_BASE : u32 = 536870912;
pub const REFCELL_NONCE_FAULT_BIT : u32 = 1073741824;
pub const MAX_RETRANSMITS : u16 = 256;
pub const MAX_RESYNCS : u8 = 32;
pub const FLUSH_BYTES : u8 = 24;
pub const SERIAL_TIMEOUT_S : u8 = 2;
pub const RESYNC_S_MAX : u8 = 8;
pub const MIN_ANSWERS_PER_S : u16 = 2500;
pub const RX_HOLE_AT : [3]u32 = [19008, 137468535, 57000000];
pub const RX_HOLE_LEN : [3]u8 = [16, 56, 19];
pub const TX_DROP_AT : [2]u32 = [120000010, 144000023];
pub const REHEARSAL_LOSSES : u8 = 5;
; the retransmit spec's ceiling, kept here so the change is stated, not hidden
pub const RT_MAX_ATTEMPTS : u8 = 3;

; --- This run -----------------------------------------------------------------------------------
pub const MAX_ATTEMPTS : u8 = 4;
pub const REOPEN_WAIT_S : u8 = 2;
pub const MAX_REOPENS : u8 = 4;
; the waits of every reopen the ceiling allows: 2 + 4 + 8 + 16
pub const REOPEN_WAIT_TOTAL_S : u8 = 30;
; the 8-token arm's ceiling again: this run sends fewer answers than that arm did (6712896 vs
; 7682304), so 3600 s holds with every ceiling spent at the 2500/s floor; the long arm's 13500
; does not apply at 7 tokens
pub const LIMIT_S : u16 = 3600;
; transport events the log keeps; the 8-token reopen spec's reasoning holds unchanged here
pub const KEEP_EVENTS : u16 = 512;

; --- Rehearsal: two stalls on top of the retransmit spec's losses ----------------------------
; The earlier reopen rehearsals' offsets, kept as they were: the reopen mechanism is
; position-independent byte counters, and the new thing this rehearsal tests is the tuned weights
; and the EOT-terminated length. Both stalls still fall inside this shorter run's streams (answer
; 5754002 of 6712896, request 2000000 of 6712896); of the five scheduled losses, four fall inside
; and fire, and the rx hole at 137468535 lies past the 127545024-byte answer stream -- the test
; block below fixes that fact too.
; answer stream: near answer 5754002, 11 bytes in
pub const RX_STALL_AT : u32 = 109326049;
; request stream: 5 bytes into request 2000000 (one-element arrays do not parse; one stall each)
pub const TX_STALL_AT : u32 = 48000005;
pub const REHEARSAL_STALLS : u8 = 2;

test node_frame {
    assert REQ_LEN == 2 + REQ_BODY;
    assert RESP_LEN == 1 + 1 + 1 + 4 + 4 + 8;
}

test flush_is_a_resync_and_nothing_else {
    assert FLUSH_BYTES >= REQ_BODY;
    assert FLUSH_BYTES % REQ_LEN == 0;
    assert FLUSH_BYTES != RESP_LEN;
}

test attempts_leave_a_spare_after_one_reopen {
    assert MAX_ATTEMPTS == RT_MAX_ATTEMPTS + 1;
    assert MAX_ATTEMPTS >= 1 + 1 + 1 + 1;
}

test ceilings {
    assert MAX_REOPENS >= 1;
    assert MAX_REOPENS <= MAX_RESYNCS;
    assert REOPEN_WAIT_TOTAL_S == REOPEN_WAIT_S * 15;
    assert MAX_REOPENS == 4;
    assert MAX_RETRANSMITS >= MAX_ATTEMPTS;
}

test run_fits_its_limit_with_every_ceiling_spent {
    assert LIMIT_S * MIN_ANSWERS_PER_S >= JOBS_EXPECTED + MAX_RETRANSMITS + MIN_ANSWERS_PER_S * RESYNC_S_MAX * MAX_RESYNCS + MIN_ANSWERS_PER_S * REOPEN_WAIT_TOTAL_S;
    assert LIMIT_S == 3600;
}

test every_event_the_ceilings_allow_is_kept {
    assert KEEP_EVENTS >= MAX_RETRANSMITS + WINDOW + MAX_RESYNCS + 1;
    assert KEEP_EVENTS * 128 < 1048576;
}

test window_unchanged {
    assert WINDOW == 24;
    assert RESP_LEN * WINDOW < 512;
}

test shorter_than_the_8_token_arm {
    assert N_TOKENS == 7;
    assert JOBS_EXPECTED > JOBS_PER_TOKEN_FULL * 4;
    assert JOBS_EXPECTED < JOBS_PER_TOKEN_FULL * N_TOKENS;
    assert JOBS_EXPECTED < 7682304;
}

test rehearsal_schedule {
    assert RX_STALL_AT == 5754002 * RESP_LEN + 11;
    assert TX_STALL_AT == 2000000 * REQ_LEN + 5;
    assert REHEARSAL_STALLS == 1 + 1;
    assert REHEARSAL_STALLS <= MAX_REOPENS;
    assert RX_STALL_AT < JOBS_EXPECTED * RESP_LEN;
    assert TX_STALL_AT < JOBS_EXPECTED * REQ_LEN;
    assert RX_HOLE_AT[0] < JOBS_EXPECTED * RESP_LEN;
    assert RX_HOLE_AT[2] < JOBS_EXPECTED * RESP_LEN;
    assert TX_DROP_AT[0] < JOBS_EXPECTED * REQ_LEN;
    assert TX_DROP_AT[1] < JOBS_EXPECTED * REQ_LEN;
    assert RX_HOLE_AT[1] > JOBS_EXPECTED * RESP_LEN;
    assert REHEARSAL_LOSSES * MAX_ATTEMPTS + REHEARSAL_STALLS * 2 * WINDOW <= MAX_RETRANSMITS;
}
