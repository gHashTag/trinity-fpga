pub const NEXTPNR_SHA256 : str = "25aeb46a747bc456c8100cd495f8c3c8265653a47ad9ad1712a049b9cffcf99d";
pub const CHIPDB : str = "~/openxc7-src/chipdb/xc7a200tfbg484-2.bin";
pub const CHIPDB_SHA256 : str = "5c88a26d973bff2fc33582f3937cc07d30bfc397ebae16d69a18fe49a14786a7";
pub const FREQ_MHZ : u8 = 50;
pub const SEED : u8 = 1;
pub const PLACER : str = "heap";
pub const ROUTER : str = "router1";
pub const WORK_DIR : str = "/tmp/e3txhold";

; --- The design, read back from the RTL -----------------------------------------------------
pub const TX_DLY : u8 = 10;
pub const DATA_PORTS : [5]str = ["eth_txd[0]", "eth_txd[1]", "eth_txd[2]", "eth_txd[3]", "eth_txctl"];
pub const CLOCK_PORT : str = "eth_txc";
pub const FF_FALL_NET : str = "tq_p";
pub const FF_RISE_NET : str = "tq_n";

; --- Timing, picoseconds --------------------------------------------------------------------
; 100BASE-TX RGMII: 25 MHz, 40 ns period; RXC duty cycle 40 to 60 % at 10/100 (RGMII v2.0)
pub const PERIOD_PS : u16 = 40000;
pub const RXC_HIGH_MIN_PS : u16 = 16000;
; RGMII v2.0 TsetupR and TholdR at the receiver, 1.0 ns minimum (TI SNLA243; plan, "The driver")
pub const SETUP_MIN_PS : u16 = 1000;
pub const HOLD_MIN_PS : u16 = 1000;
; the bench's stand-in for the chain (formal/ksz9031_frame_model.v), for comparison only
pub const BENCH_TX_DELAY_PS : u16 = 3000;
pub const GUESS_HOLD_LO_PS : u16 = 2000;
pub const GUESS_HOLD_HI_PS : u16 = 10000;

test duty_cycle_bound {
    assert 100 * RXC_HIGH_MIN_PS == 40 * PERIOD_PS;
    assert 2 * RXC_HIGH_MIN_PS < PERIOD_PS;
}

test window_is_open {
    assert HOLD_MIN_PS + SETUP_MIN_PS < RXC_HIGH_MIN_PS;
    assert BENCH_TX_DELAY_PS >= HOLD_MIN_PS;
}

test guess_inside_window {
    assert GUESS_HOLD_LO_PS >= HOLD_MIN_PS;
    assert GUESS_HOLD_HI_PS + SETUP_MIN_PS <= RXC_HIGH_MIN_PS;
    assert GUESS_HOLD_LO_PS < GUESS_HOLD_HI_PS;
}

test e3z_build {
    assert FREQ_MHZ == 50;
    assert SEED == 1;
    assert TX_DLY == 10;
}
