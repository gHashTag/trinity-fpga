; --- The e3z build on this Mac: checked by the runner, not by the generator -----------------
pub const BUILD_DIR : str = "/tmp/trinet-node-build/e3z";
pub const NODE_JSON_SHA256 : str = "3b91491691a17672e178eef06291456039e9103a2dfe1a2564cf305c89bd1f32";
pub const FASM_SHA256 : str = "95809a97d96c563ebb02c954d24d1848d1e5ef3a85c7af1668a666dffc5fb265";
