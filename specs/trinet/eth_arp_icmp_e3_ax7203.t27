// SPDX-License-Identifier: Apache-2.0
; specs/trinet/eth_arp_icmp_e3_ax7203.t27 -- pre-registration: Ethernet step E3 on the AX7203,
; the board answering ARP and ping at 192.168.1.222
; The one source for this board step. conformance/eth_arp_icmp_e3_from_spec.mjs compiles this file
; with the t27 compiler (wasm), evaluates every test block below, checks the pinned files, reads back
; the constants it repeats from the RTL, the checker, the bitstream record and the E2z log, and
; writes conformance/eth_arp_icmp_e3_params.py, which `eth_arp_icmp_ax7203.py --judge` reads.
; `--check` fails on drift. Written 2026-09-27 before the bitstream was ever on the board. ASCII,
; English.

; WHY. E2 with the one-bit fix (e2z) read the KSZ9031 over MDIO on the board: PHY id 00221622 on
; 40 of 40 lines, link 100 full duplex, in-band status 0xB, frames seen on RXD. E3 adds receive,
; a 2-slot RAMB36 buffer and transmit on the same pins and answers ARP and ICMP echo. It is built
; (payload below) and passes the checker's self-test, static, RTL and gate simulations against
; formal/ksz9031_frame_model.v. The board is the only test of the real pad timing (RXD sampled on
; the falling edge of RXC, TXC = RXC inverted, TX data through TX_DLY LUT1 stages) and of the first
; RAMB36 this flow has put on this board. This file fixes the verdict before that test.

; WHAT RUNS. Six tri fpga-run / tri fpga-flash logs in conformance/board_runs, in this order by
; their # start stamps; the judge refuses logs that are missing, out of order, or ran another
; command:
;   LOG_PREPING  ping -c PRE_PING_COUNT IP_TEXT, before the flash: nobody may answer there
;   LOG_FLASH    tri fpga-flash of the bitstream whose payload is PAYLOAD_SHA256 (owner's yes)
;   LOG_BEFORE   eth_arp_icmp_ax7203.py --port ... --lines UART_LINES
;   LOG_PING     ping -c PING_COUNT IP_TEXT
;   LOG_ARP      arp -an
;   LOG_AFTER    eth_arp_icmp_ax7203.py --port ... --lines UART_LINES
; Then the node bitstream goes back on the board and the W24 control runs, as after E2 and E2z;
; those two are recorded, not judged here.

; THE JUDGE. `python3 conformance/eth_arp_icmp_ax7203.py --judge`. The checker's bytes are pinned
; below (RUNNER_SHA256), so the rules cannot change once the logs exist. Deltas d_x are the last
; report line of LOG_AFTER minus the last line of LOG_BEFORE, mod 65536 (counters are 16-bit).
; "Every line" is every report line of LOG_BEFORE and LOG_AFTER. rx is the host's received count
; from LOG_PING, tx its transmitted count.
;   CONFLICT  LOG_PREPING got more than PRE_PING_MAX_REPLIES replies: the address was in use.
;   H1        works. All of: tx == PING_COUNT; rx >= PING_MIN_REPLIES; arp -an maps IP_TEXT to
;             MAC; d_eq >= rx; d_er == d_eq; d_aq >= 1; d_ar == d_aq; on every line lk == 1,
;             ib == IB and id == PHY_ID; every line's rc in [RC_MIN, RC_MAX].
;   H4        not H1, and some line has lk != 1 or ib != IB: no stable 100M full-duplex link.
;   H3        not H1 or H4, and d_aq == 0 and d_eq == 0: the link is up and the board recognised
;             none of the host's requests (receive path).
;   H2        not the above, d_ar >= 1 or d_er >= 1, and rx == 0: the board counted replies
;             sent and the host got none (transmit path or the RAMB).
;   OTHER     anything else, for example 1..PING_MIN_REPLIES-1 replies, d_er != d_eq, another MAC
;             in the ARP table, rc out of bounds with everything else right.
; PASS is H1 only. fe, ce, ed and d_rx are printed, not judged: fe and ce count the LAN's frames
; too, and ed says whether a rising-edge RXD sample would have worked as well (0 = yes).

; PREDICTION. H1.

; WHAT IT DOES NOT SAY.
;   That the design is right under load, with jumbo pings, or at 1000M: E3 is 100BASE-TX only, and
;   one ping per second never fills the second buffer slot. That the TX timing margin is large:
;   only that it was enough on this board, this cable, this switch. Anything about 10M. Anything
;   about the node's key or receipts: E3 carries no MAC and no key. One attempt; a second only if
;   the first fails before its first report line, and then both are recorded.

; ROUTER. nextpnr-xilinx fix/zinv-t1-pad-pip f3a8c73c, router1 (e3z). A router2 build (e3h2)
; routed BRAM address nets through the cascade wires of unused neighbour tiles; it is not the one
; pinned here and is not to be flashed first.

module trinet_eth_arp_icmp_e3_ax7203;

pub const KIND : str = "board-diagnostic-preregistration";
pub const ID : str = "trinet/eth_arp_icmp_e3_ax7203";
pub const GENERATED : [1]str = ["conformance/eth_arp_icmp_e3_params.py"];
pub const RUNNER : str = "conformance/eth_arp_icmp_ax7203.py";
pub const RUNNER_SHA256 : str = "9fed2bde85d50316d3943030d4ac6b7443cbe5a00952134a40d2fd8e6f0466ef";
pub const RECORD_DOC : str = "conformance/NODE_ETHERNET_PLAN.md";

; --- The six logs, in order (conformance/board_runs/NAME.log) ---------------------------------
pub const LOG_PREPING : str = "e3_preping";
pub const LOG_FLASH : str = "e3_flash";
pub const LOG_BEFORE : str = "e3_uart_before";
pub const LOG_PING : str = "e3_ping";
pub const LOG_ARP : str = "e3_arp";
pub const LOG_AFTER : str = "e3_uart_after";

; --- Code and data of record: never edited -------------------------------------------------
pub const RTL_FILE : str = "fpga/vivado/eth_arp_icmp_ax7203.v";
pub const RTL_SHA256 : str = "72ccbf907ef6e2b38570f71bd5da6fa492cec0baf547501b50eca9cfd1edb763";
pub const XDC_FILE : str = "specs/fpga/constraints/eth_arp_icmp_ax7203.xdc";
pub const XDC_SHA256 : str = "8921492b31f5e34f28d0d10b59a59e431c9f6f449a2d694713ac9781b8f5535e";
