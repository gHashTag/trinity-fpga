pub const MODEL_SHA256 : str = "392727916c85e4ac14a129c042829cdbe13cafa59bf116ca9fa5fe5f0c3a2300";
pub const TB_FILE : str = "formal/eth_arp_icmp_tb.v";
pub const TB_SHA256 : str = "f59a165c3161fa370b217efc9d15b3cf4066be4d683d4c743c35e29587485adb";
pub const RAMB_MOCK_FILE : str = "fpga/openxc7-synth/RAMB36E1_mock.v";
pub const RAMB_MOCK_SHA256 : str = "e304d2ca1b154e7b8e728a30352424e2e810ab37a8a64b7835cf9b65fcf499ba";
pub const STARTUP_MOCK_FILE : str = "fpga/openxc7-synth/STARTUPE2_mock.v";
pub const STARTUP_MOCK_SHA256 : str = "512a152f465a08528bf0b3bbd8d14d41338844ff6bff45acc0847b07ca476ef4";
pub const BIT_RECORD_FILE : str = "artifacts/bitstreams/e3_eth_arp_icmp_zinv_t1.bit.sha256";
pub const BIT_RECORD_SHA256 : str = "2f482d26c424a6ea2041beaba37664d5013cab1f3c42dfe4aa875764d51c944f";
; the E2z report lines the rc bounds are checked against
pub const E2Z_LOG_FILE : str = "conformance/board_runs/e2z_phy_status.log";
pub const E2Z_LOG_SHA256 : str = "a9186cd94283bf34da9d6c0fc3fa615718be0ab6c7455baab6878f148fa1a1f0";

; --- The bitstream (the .bit itself is not in git; the record above is) ----------------------
pub const BIT_NAME : str = "artifacts/bitstreams/e3_eth_arp_icmp_zinv_t1.bit";
; sha256 from the sync word 0xAA995566 on, as tri fpga-flash computes it and --expect checks it
pub const PAYLOAD_SHA256 : str = "4fd7923d0d65b06cfffd877c7a73411e73f7d1e2e535b2acff18b49cb6b684c9";
pub const BIT_FILE_SHA256 : str = "e75a6ff75d49d82e8e51af089fe1a49e4da230eb0b167a66b185910b1f555695";

; --- The design's identity: read back from the RTL parameters and the checker ---------------
pub const IP_TEXT : str = "192.168.1.222";
pub const IP_U32 : u32 = 3232235998;
; MAC 02:00:5E:F9:00:01, locally administered
pub const MAC_HI16 : u16 = 512;
pub const MAC_LO32 : u32 = 1593376769;
pub const TTL : u8 = 64;
; KSZ9031RNX PHYID1:PHYID2
pub const PHY_ID : u32 = 2233890;
; report field ib: answered and in-band seen (3), in-band 0xB = link, 100M, full duplex
pub const IB : u8 = 59;

; --- Host side ------------------------------------------------------------------------------
pub const PRE_PING_COUNT : u8 = 2;
pub const PRE_PING_MAX_REPLIES : u8 = 0;
pub const PING_COUNT : u8 = 20;
; the Mac is on Wi-Fi, the board on the router's switch: two of twenty may be lost on the air
pub const PING_MIN_REPLIES : u8 = 18;
pub const UART_LINES : u8 = 10;
pub const POLL_LOG2 : u8 = 25;

; --- rc: RXC edges counted over 2^WIN_LOG2 cycles of CFGMCLK ---------------------------------
pub const WIN_LOG2 : u8 = 20;
pub const RXC_HZ : u32 = 25000000;
pub const RXC_PPM : u8 = 100;
pub const RXC_LO_HZ : u32 = 24997500;
pub const RXC_HI_HZ : u32 = 25002500;
pub const CFGMCLK_MIN_HZ : u32 = 65600000;
pub const CFGMCLK_MAX_HZ : u32 = 68700000;
; floor(RXC_LO_HZ 2^20 / CFGMCLK_MAX_HZ) - 1 and ceil(RXC_HI_HZ 2^20 / CFGMCLK_MIN_HZ) + 1; the
; one count each side is the window's edge
pub const RC_MIN : u32 = 381538;
pub const RC_MAX : u32 = 399651;
; E2z on the board, the 36 report lines with ib=3B: rc 0x05EF84 .. 0x05F0F6
pub const E2Z_IB_LINES : u8 = 36;
pub const E2Z_RC_MIN : u32 = 388996;
pub const E2Z_RC_MAX : u32 = 389366;

test identity {
    assert IP_U32 == 192 * 16777216 + 168 * 65536 + 1 * 256 + 222;
    assert MAC_HI16 == 2 * 256 + 0;
    assert MAC_LO32 == 94 * 16777216 + 249 * 65536 + 0 * 256 + 1;
    assert PHY_ID == 34 * 65536 + 22 * 256 + 34;
    assert IB == 3 * 16 + 11;
    assert TTL == 64;
}

test rc_bounds_are_25_mhz_over_the_cfgmclk_range {
    assert 1000000 * RXC_LO_HZ == RXC_HZ * (1000000 - RXC_PPM);
    assert 1000000 * RXC_HI_HZ == RXC_HZ * (1000000 + RXC_PPM);
    assert WIN_LOG2 == 20;
    assert CFGMCLK_MAX_HZ * (RC_MIN + 1) <= RXC_LO_HZ * 1048576;
    assert RXC_LO_HZ * 1048576 < CFGMCLK_MAX_HZ * (RC_MIN + 2);
    assert CFGMCLK_MIN_HZ * (RC_MAX - 2) < RXC_HI_HZ * 1048576;
    assert RXC_HI_HZ * 1048576 <= CFGMCLK_MIN_HZ * (RC_MAX - 1);
}

test e2z_lies_inside_the_bounds {
    assert RC_MIN <= E2Z_RC_MIN;
    assert E2Z_RC_MIN <= E2Z_RC_MAX;
    assert E2Z_RC_MAX <= RC_MAX;
    assert E2Z_IB_LINES > 0;
}

test host_side {
    assert PRE_PING_MAX_REPLIES == 0;
    assert PING_MIN_REPLIES <= PING_COUNT;
    assert 10 * PING_MIN_REPLIES >= 9 * PING_COUNT;
    assert UART_LINES >= 2;
}

; the checker's read gives up after 1.5 s per line + 5 s; a line comes every 2^POLL_LOG2 cycles,
; and the first one up to one period after the port opens
test uart_read_fits_its_timeout {
    assert POLL_LOG2 == 25;
    assert 2 * (UART_LINES + 1) * 33554432 < CFGMCLK_MIN_HZ * (3 * UART_LINES + 10);
}
