pub const RT_RUNNER_SHA256 : str = "b42ab095684d7019a51b4e5ef0fc92ee4d543a4c0a7f120d8be8736e6d833492";
pub const REOPEN_FILE : str = "conformance/tern_tc_reopen.py";
pub const REOPEN_SHA256 : str = "4bfd81b3ae1974a3d4b028bf26d4a30f8484f7087e5514f582002fa6c79cb14d";

; --- Repeated from the generation spec; the generator reads each back from its params -------
pub const N_TOKENS : u8 = 8;
pub const JOBS_EXPECTED : u32 = 7682304;
pub const JOBS_PER_TOKEN_FULL : u32 = 1209600;
pub const FIRST_JOB_NONCE : u32 = 65536;
pub const SETKEY_NONCE : u32 = 2122186753;
pub const WINDOW : u8 = 24;
pub const RESP_LEN : u8 = 19;
pub const BAUD : u32 = 1144744;
pub const NODE_ID : u32 = 1414678862;

; --- Repeated from the retransmit spec; read back from its params ----------------------------
pub const REQ_LEN : u8 = 24;
pub const REQ_BODY : u8 = 22;
pub const RETRY_BASE : u32 = 536870912;
pub const REFCELL_NONCE_FAULT_BIT : u32 = 1073741824;
pub const MAX_RETRANSMITS : u16 = 256;
pub const MAX_RESYNCS : u8 = 32;
pub const FLUSH_BYTES : u8 = 24;
pub const SERIAL_TIMEOUT_S : u8 = 2;
pub const RESYNC_S_MAX : u8 = 8;
pub const MIN_ANSWERS_PER_S : u16 = 2500;
pub const RX_HOLE_AT : [3]u32 = [19008, 137468535, 57000000];
pub const RX_HOLE_LEN : [3]u8 = [16, 56, 19];
pub const TX_DROP_AT : [2]u32 = [120000010, 144000023];
pub const REHEARSAL_LOSSES : u8 = 5;
; the retransmit spec's ceiling, kept here so the change is stated, not hidden
pub const RT_MAX_ATTEMPTS : u8 = 3;

; --- This run -----------------------------------------------------------------------------------
pub const MAX_ATTEMPTS : u8 = 4;
pub const REOPEN_WAIT_S : u8 = 2;
pub const MAX_REOPENS : u8 = 4;
; the waits of every reopen the ceiling allows: 2 + 4 + 8 + 16
pub const REOPEN_WAIT_TOTAL_S : u8 = 30;
pub const LIMIT_S : u16 = 3600;
; transport events the log keeps. The protocol records one per lost nonce and one per resync, and
; keeps only the first keep_events (64 by default). The first rehearsal of this spec had 7 resyncs and
; showed 5: the rest fell past 64. A failure after a reopen is the branch this run tests, so its events
; must reach the log. Losses are at most the retransmits plus one window still in flight at a stop.
pub const KEEP_EVENTS : u16 = 512;

; --- Rehearsal: two stalls on top of the retransmit spec's losses ----------------------------
; A stall makes one direction deliver nothing until the port is reopened (tern_tc_reopen.Stall). It
; sits outside the lossy cell, so its offsets count the stream the host receives: after the scheduled
; holes, with retransmitted answers and flush answers in it. Where a stall falls inside a frame
; therefore depends on the losses before it, and does not matter to the reopen: any silence through a
; whole resync triggers it.
; answer stream: near answer 5754002, the retransmit run's last verified answer, 11 bytes in
pub const RX_STALL_AT : u32 = 109326049;
; request stream: 5 bytes into request 2000000 (one-element arrays do not parse; one stall each)
pub const TX_STALL_AT : u32 = 48000005;
pub const REHEARSAL_STALLS : u8 = 2;

test node_frame {
    assert REQ_LEN == 2 + REQ_BODY;
    assert RESP_LEN == 1 + 1 + 1 + 4 + 4 + 8;
}

test flush_is_a_resync_and_nothing_else {
    assert FLUSH_BYTES >= REQ_BODY;
    assert FLUSH_BYTES % REQ_LEN == 0;
    assert FLUSH_BYTES != RESP_LEN;
}

test attempts_leave_a_spare_after_one_reopen {
    assert MAX_ATTEMPTS == RT_MAX_ATTEMPTS + 1;
    assert MAX_ATTEMPTS >= 1 + 1 + 1 + 1;
}

test ceilings {
    assert MAX_REOPENS >= 1;
    assert MAX_REOPENS <= MAX_RESYNCS;
    assert REOPEN_WAIT_TOTAL_S == REOPEN_WAIT_S * 15;
    assert MAX_REOPENS == 4;
    assert MAX_RETRANSMITS >= MAX_ATTEMPTS;
}

test run_fits_its_limit_with_every_ceiling_spent {
    assert LIMIT_S * MIN_ANSWERS_PER_S >= JOBS_EXPECTED + MAX_RETRANSMITS + MIN_ANSWERS_PER_S * RESYNC_S_MAX * MAX_RESYNCS + MIN_ANSWERS_PER_S * REOPEN_WAIT_TOTAL_S;
    assert LIMIT_S <= 3600;
}

test every_event_the_ceilings_allow_is_kept {
    assert KEEP_EVENTS >= MAX_RETRANSMITS + WINDOW + MAX_RESYNCS + 1;
    assert KEEP_EVENTS * 128 < 1048576;
}

test window_unchanged {
    assert WINDOW == 24;
    assert RESP_LEN * WINDOW < 512;
}

test rehearsal_schedule {
    assert RX_STALL_AT == 5754002 * RESP_LEN + 11;
    assert TX_STALL_AT == 2000000 * REQ_LEN + 5;
    assert REHEARSAL_STALLS == 1 + 1;
    assert REHEARSAL_STALLS <= MAX_REOPENS;
    assert RX_STALL_AT < RX_HOLE_AT[1];
    assert TX_STALL_AT < TX_DROP_AT[0];
    assert REHEARSAL_LOSSES * MAX_ATTEMPTS + REHEARSAL_STALLS * 2 * WINDOW <= MAX_RETRANSMITS;
}
