; --- The design, read back from the RTL -----------------------------------------------------
pub const CLOCK_PORT : str = "eth_rxc";
pub const RXC_NET : str = "rxc";
pub const DATA_PORTS : [4]str = ["eth_rxd[0]", "eth_rxd[1]", "eth_rxd[2]", "eth_rxd[3]"];
pub const CTL_PORT : str = "eth_rxctl";
pub const MID_NET : str = "rxd_n";
pub const START_NET : str = "rxd_p1";
pub const CTL_MID_NET : str = "rxctl_n";

; --- Timing, picoseconds --------------------------------------------------------------------
; 100BASE-TX RGMII: 25 MHz, 40 ns period; RXC duty cycle 40 to 60 % at 10/100 (RGMII v2.0)
pub const PERIOD_PS : u16 = 40000;
pub const RXC_HIGH_MIN_PS : u16 = 16000;
pub const RXC_LOW_MIN_PS : u16 = 16000;
pub const MARGIN_MIN_PS : u16 = 1000;
; KSZ9031 RX clock delay at reset pad skews; the driver's register step is 60 ps (KSZ9031_PS_TO_REG)
pub const PHY_DELAY_LO_PS : u16 = 0;
pub const PHY_DELAY_NOM_PS : u16 = 1200;
pub const PHY_DELAY_HI_PS : u16 = 2000;
pub const PAD_SKEW_STEP_PS : u16 = 60;
pub const SKEW_PS : u16 = 500;
pub const X_EARLY_MAX_PS : u16 = 2500;
pub const X_LATE_MAX_PS : u16 = 500;
pub const GUESS_VERDICT : str = "PASS";
pub const GUESS_ED_RANGE : str = "undetermined";
pub const GUESS_ED_NOMINAL : str = "new";
pub const GUESS_RXER_RANGE : str = "undetermined";
pub const GUESS_RXER_NOMINAL : str = "new";

test duty_cycle_bound {
    assert 100 * RXC_HIGH_MIN_PS == 40 * PERIOD_PS;
    assert RXC_LOW_MIN_PS == RXC_HIGH_MIN_PS;
    assert RXC_HIGH_MIN_PS + RXC_LOW_MIN_PS < PERIOD_PS;
}

test x_range_from_phy {
    assert X_EARLY_MAX_PS == PHY_DELAY_HI_PS + SKEW_PS;
    assert X_LATE_MAX_PS + PHY_DELAY_LO_PS == SKEW_PS;
    assert PHY_DELAY_LO_PS <= PHY_DELAY_NOM_PS;
    assert PHY_DELAY_NOM_PS <= PHY_DELAY_HI_PS;
    assert PHY_DELAY_NOM_PS == 20 * PAD_SKEW_STEP_PS;
}

test window_is_open {
    assert X_EARLY_MAX_PS + X_LATE_MAX_PS + 2 * MARGIN_MIN_PS < RXC_HIGH_MIN_PS;
    assert X_EARLY_MAX_PS + X_LATE_MAX_PS < RXC_LOW_MIN_PS;
}

test pinned_sizes {
    assert SDF_BYTES > 1000000;
    assert SDF_BYTES < 4000000;
}
